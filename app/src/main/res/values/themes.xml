<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Tema de arranque: el mismo grafito del icono y de la app, para que la ventana
      no destelle en blanco antes de que Compose dibuje.
    -->
    <style name="Theme.Nodo" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/fondo</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
